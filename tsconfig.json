{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "#/*": ["src/components/*"]
    },
    "allowSyntheticDefaultImports": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "jsx": "react-jsx",
    "module": "node16",
    "target": "esnext",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "moduleResolution": "node16",
    "importHelpers": true,
    "noEmit": true,
    "lib": ["dom", "esnext", "DOM.Iterable", "scripthost", "es2015"],
    "declaration": true,
    "declarationMap": true
  },
  "include": ["**/*.ts", "**/*.d.ts", "**/*.tsx", "src/data"]
}
